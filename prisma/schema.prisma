generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  createdAt       DateTime     @default(now())
  passwordHash    String
  username        String       @unique
  workplaceId     Int?
  id              Int          @id @default(autoincrement())
  name            String
  field           Field?
  role            Role?
  assignments     Assignment[]
  receivedInvites Invite[]     @relation("receivedInvites")
  sentInvites     Invite[]     @relation("sentInvites")
  workplace       Workplace?   @relation("workplaceMembers", fields: [workplaceId], references: [id])
  myWorkplace     Workplace?   @relation("workplaceOwner")
}

model Workplace {
  id        Int       @id @default(autoincrement())
  name      String
  ownerId   Int       @unique
  createdAt DateTime  @default(now())
  invites   Invite[]
  products  Product[]
  members   User[]    @relation("workplaceMembers")
  owner     User      @relation("workplaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
}

model Product {
  name         String
  createdAt    DateTime     @default(now())
  amount       Int
  description  String?
  workplaceId  Int
  id           Int          @id @default(autoincrement())
  colors       Json
  salary       Json
  mid_tailor   Int
  right_tailor Int
  top_tailor   Int
  lines        Int
  done         Int          @default(0)
  assignments  Assignment[]
  workplace    Workplace    @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
}

model Assignment {
  id        Int      @id @default(autoincrement())
  quantity  Int
  productId Int
  workerId  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Invite {
  id          Int        @id @default(autoincrement())
  workplaceId Int
  senderId    Int
  receiverId  Int
  status      Invitation @default(PENDING)
  createdAt   DateTime   @default(now())
  receiver    User       @relation("receivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User       @relation("sentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  workplace   Workplace  @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
}

enum Invitation {
  PENDING
  ACCEPTED
  REJECTED
}

enum Field {
  rightTailor
  topTailor
  midTailor
  general
}

enum Role {
  MANAGER
  WORKER
}
