// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
//USER-> COMPANY -> PRODUCT -> MANAGER -> WORKER

model User {
  id Int @id @default(autoincrement())
  name String
  username String @unique
  passwordHash String
  role Role?
  field Field?

  workplaceId Int?
  workplace Workplace? @relation("workplaceMembers" , fields: [workplaceId] , references: [id])

  myWorkplace Workplace? @relation("workplaceOwner")

  assignments Assignment[]

  sentInvites Invite[] @relation("sentInvites")
  receivedInvites Invite[] @relation("receivedInvites")

  createdAt DateTime @default(now())
}

model Workplace {
  id Int @id @default(autoincrement())
  name String

  ownerId Int @unique
  owner User @relation("workplaceOwner" , fields: [ownerId] , references: [id],onDelete: Cascade )

  members User[] @relation("workplaceMembers")
  products Product[]

  invites Invite[]

  createdAt DateTime @default(now())
}
model Product {
  id Int @id @default(autoincrement())
  name String
  description String?
  colors Json
  amount Int

  workplaceId Int
  workplace Workplace @relation(fields: [workplaceId], references: [id] ,onDelete: Cascade)

  assignments Assignment[]

  createdAt DateTime @default(now())
}
model Assignment {
  id Int @id @default(autoincrement())
  quantity Int

  productId Int
  product Product @relation(fields: [productId], references: [id] )

  workerId Int
  worker User @relation(fields: [workerId], references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

}
model Invite {
  id Int @id @default(autoincrement())

  workplaceId Int 
  workplace Workplace @relation(fields: [workplaceId], references: [id])

  senderId Int
  sender User @relation("sentInvites" , fields: [senderId] , references: [id])

  receiverId Int
  receiver User @relation("receivedInvites" , fields: [receiverId] , references: [id])

  status Invitation @default(PENDING)

  createdAt DateTime @default(now())
}
enum Invitation {
  PENDING
  ACCEPTED
  REJECTED
}
enum Field {
  rightTailor
  topTailor
  midTailor
}
enum Role {
  MANAGER
  WORKER
}